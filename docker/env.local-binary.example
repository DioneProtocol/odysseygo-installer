# OdysseyGo Docker Environment Variables for Local Binary Testing
# Copy this file to .env and modify as needed

# Local Binary Configuration
# Path to your local odysseygo binary directory (relative to docker directory)
# This should contain the odysseygo binary and any other required files
# Example: LOCAL_BINARY_PATH=../odysseygo/build
LOCAL_BINARY_PATH=

# Docker Hub Image Configuration (not used when using local binary)
DOCKERHUB_USERNAME=yourusername
IMAGE_TAG=develop

# Network configuration
NETWORK=mainnet

# Bootstrap configuration
# Set to empty string to disable bootstrap and sync from scratch
# Leave empty to start fresh without bootstrap data
BOOTSTRAP_URL=

# Alternative: Use bootstrap (uncomment one of these lines)
# BOOTSTRAP_URL=https://odysseygo-bootstraps.nyc3.cdn.digitaloceanspaces.com/odyssey-bootstrap-mainnet.zip
# BOOTSTRAP_URL=https://odysseygo-bootstraps.nyc3.cdn.digitaloceanspaces.com/odyssey-bootstrap-testnet.zip

# RPC and API configuration
RPC_ACCESS=public
ADMIN_API=false
ETH_DEBUG_RPC=true

# State sync configuration
STATE_SYNC=off

# Network and IP configuration
IP_MODE=dynamic
PUBLIC_IP=0.0.0.0

# Database and logging
DB_DIR=/odysseygo/db
LOG_LEVEL_NODE=info
LOG_LEVEL_DCHAIN=info

# Node features
INDEX_ENABLED=true
ARCHIVAL_MODE=true

# Port configuration
RPC_HOST_PORT=9650
P2P_HOST_PORT=9651
