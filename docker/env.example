# OdysseyGo Docker Environment Variables
# Copy this file to .env and modify as needed

# Docker Hub Image Configuration
# Replace 'yourusername' with your actual Docker Hub username
DOCKERHUB_USERNAME=yourusername
# Image tag to use (develop, main, or specific version)
IMAGE_TAG=develop

# Network configuration
NETWORK=mainnet

# Bootstrap configuration
# Set BOOTSTRAP_URL to download pre-synced blockchain data for faster startup
# Leave empty to sync from scratch (slower but verifies entire chain)
#
# For MAINNET:
BOOTSTRAP_URL=https://odysseygo-bootstraps.nyc3.digitaloceanspaces.com/odyssey-bootstrap-mainnet.zip
#
# For TESTNET (comment mainnet line above and uncomment this):
# BOOTSTRAP_URL=https://odysseygo-bootstraps.nyc3.digitaloceanspaces.com/odyssey-bootstrap-testnet.zip
#
# To sync from scratch (no bootstrap):
# BOOTSTRAP_URL=

# RPC and API configuration
RPC_ACCESS=public
ADMIN_API=false
ETH_DEBUG_RPC=true

# State sync configuration
STATE_SYNC=off

# Network and IP configuration
IP_MODE=dynamic
PUBLIC_IP=0.0.0.0

# Database and logging
DB_DIR=/odysseygo/db
LOG_LEVEL_NODE=info
LOG_LEVEL_DCHAIN=info

# Node features
INDEX_ENABLED=true
ARCHIVAL_MODE=true

# Port configuration
RPC_HOST_PORT=9650
P2P_HOST_PORT=9651 