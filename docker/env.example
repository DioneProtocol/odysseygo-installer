# OdysseyGo Docker Environment Variables
# Copy this file to .env and modify as needed

# Multi-instance setup: if running multiple nodes on the same server by cloning
# this repo into separate folders, each instance MUST have unique values for:
#   COMPOSE_PROJECT_NAME - avoids container/network name collisions
#   RPC_HOST_PORT / P2P_HOST_PORT - avoids port conflicts
# Example for a second instance: COMPOSE_PROJECT_NAME=node2, ports 9652/9653

# Docker Compose project name (used to namespace containers and networks).
# Set a unique name per instance when running multiple nodes on the same server.
COMPOSE_PROJECT_NAME=odysseygo

# Docker Hub Image Configuration
# Replace 'yourusername' with your actual Docker Hub username
DOCKERHUB_USERNAME=yourusername
# Image tag to use (develop, main, or specific version)
IMAGE_TAG=develop

# Network configuration
NETWORK=mainnet

# Bootstrap configuration
# Set BOOTSTRAP_URL to download pre-synced blockchain data for faster startup
# Leave empty to sync from scratch (slower but verifies entire chain)
#
# For MAINNET:
BOOTSTRAP_URL=https://odysseygo-bootstraps.nyc3.digitaloceanspaces.com/odyssey-bootstrap-mainnet.zip
#
# For TESTNET (comment mainnet line above and uncomment this):
# BOOTSTRAP_URL=https://odysseygo-bootstraps.nyc3.digitaloceanspaces.com/odyssey-bootstrap-testnet.zip
#
# To sync from scratch (no bootstrap):
# BOOTSTRAP_URL=

# RPC and API configuration
RPC_ACCESS=public
ADMIN_API=false
ETH_DEBUG_RPC=true

# State sync configuration
STATE_SYNC=off

# Network and IP configuration
IP_MODE=dynamic
PUBLIC_IP=0.0.0.0

# Database and logging
DB_DIR=/odysseygo/db
LOG_LEVEL_NODE=info
LOG_LEVEL_DCHAIN=info

# Node features
INDEX_ENABLED=true
ARCHIVAL_MODE=true

# Port configuration
# Must be unique per instance when running multiple nodes on the same server
RPC_HOST_PORT=9650
P2P_HOST_PORT=9651